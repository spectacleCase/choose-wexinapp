.recommendation-result {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: #f0f0f0;
  overflow: hidden;
}

.bubble-container {
  position: absolute;
  width: 100%;
  height: 100%;
}

.bubble {
  position: absolute;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: float 15s infinite linear;
  bottom: -50px; /* 从视图底部以下开始 */
}

.bubble-icon {
  width: 50%;
  height: 50%;
}

@keyframes float {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(-110vh) rotate(360deg); /* 移动到视图顶部以上 */
    opacity: 0;
  }
}

.info-capsule-swiper {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  height: 70%;
}

.info-capsule {
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  height: 100%;
  display: flex;
  flex-direction: column;
}

.dish-image {
  width: 100%;
  height: 50%;
  border-radius: 10px;
  margin-bottom: 15px;
  object-fit: cover;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dish-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.dish-name {
  font-size: 24px;
  font-weight: bold;
}

.stars {
  color: #FFD700;
  font-size: 18px;
}

.shop-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.shop-name {
  font-size: 16px;
  color: #666;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.tag {
  background-color: #FFE4B5;
  color: #FF8C00;
  padding: 4px 8px;
  border-radius: 12px;
  margin: 2px;
  font-size: 12px;
}

.ai-description {
  margin-top: 15px;
  padding: 10px;
  background-color: rgba(255, 140, 0, 0.1);
  border-radius: 8px;
}

.ai-label {
  display: block;
  font-weight: bold;
  font-size: 14px;
  color: #FF8C00;
  margin-bottom: 5px;
}

.ai-content {
  display: block;
  font-size: 14px;
  color: #333;
  line-height: 1.4;
}

.arrow {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 40px;
  height: 40px;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  z-index: 10;
}

.arrow-up {
  top: 20px;
}

.arrow-down {
  bottom: 20px;
}

.arrow-text {
  font-size: 24px;
  color: #FF8C00;
}

.navigation-container {
  display: flex;
  align-items: center;
}

.navigation-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 6rpx;
}

.navigation-text {
  font-size: 22rpx;
  color: #4A90E2;
}

/* 论文 4-5 章 Agent 协作链路信息 */
.agent-meta {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 18rpx;
  background: rgba(99, 102, 241, 0.15);
  border-radius: 28rpx;
  font-size: 22rpx;
  color: #4338ca;
}
.agent-meta-label { font-weight: bold; }
.agent-meta-trace { font-family: monospace; opacity: 0.7; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.agent-meta-pl {
  background: #ddd6fe;
  color: #6d28d9;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

/* 论文 3.1.4 矛盾约束追问条 */
.clarify-bar {
  position: absolute;
  top: 80rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 10;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 20rpx;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border: 1rpx solid #f59e0b;
  border-radius: 16rpx;
}
.clarify-icon {
  flex-shrink: 0;
  width: 36rpx; height: 36rpx;
  background: #f59e0b;
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
  line-height: 36rpx;
}
.clarify-text {
  font-size: 24rpx;
  color: #78350f;
  line-height: 1.5;
}

/* 论文 5.2 满意度评分 */
.rating-bar {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.4);
}
.rating-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 10rpx;
}
.rating-stars {
  display: flex;
  gap: 14rpx;
}
.rating-star {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.4);
  transition: color 0.18s;
}
.rating-star.rated {
  color: #fbbf24;
}
.rating-star:active {
  transform: scale(1.2);
}
.rating-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #fbbf24;
}
